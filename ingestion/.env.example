# Copy to repo-root .env (gitignored) and fill in. Only needed for live Snowflake loads.
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=LITTLEVITALS_DB
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=LITTLEVITALS_ENGINEER

# Optional override for the AIHW API base URL.
# AIHW_BASE_URL=https://myhospitalsapi.aihw.gov.au/api/v1
